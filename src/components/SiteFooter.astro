---
const year = new Date().getFullYear();
---

{/* The reference ad closes on an oversized brand plate — same move here. */}
<footer class="border-t-2 border-signal/50">
  <div class="page-container pt-14 pb-10">
    <p
      class="neon font-display text-[12vw] leading-[1.1] uppercase [--tube:var(--color-signal)] lg:text-[7rem]"
    >
      Mint
    </p>

    <div
      class="mt-8 flex flex-col gap-4 border-t-2 border-phosphor/20 pt-6 text-sm font-normal tracking-widest uppercase sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-phosphor-dim">A Hack Club YSWS</p>
      <p>
        <a
          href="https://slack.com/archives/C0BK69GFA0Z"
          class="inline-flex items-center py-2 text-mint hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint pointer-coarse:py-3"
        >
          #mint on Slack
        </a>
      </p>
      <p class="text-phosphor-dim">&copy; {year}</p>
    </div>
  </div>
</footer>
