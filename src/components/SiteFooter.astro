---
const year = new Date().getFullYear();

// Required on every Hack Club YSWS site, so these are not optional links and
// should not be pruned as clutter. Labels use Hack Club's own naming rather
// than a paraphrase, so they stay recognisable against the requirement.
const required = [
  { href: 'https://hackclub.com/privacy-and-terms', label: 'Privacy Policy & Terms' },
  { href: 'https://forms.hackclub.com/bounty', label: 'Fulfillment bounty' },
];
---

{/* The reference ad closes on an oversized brand plate — same move here. */}
<footer class="border-t-2 border-signal/50">
  <div class="page-container pt-14 pb-10">
    <p
      class="misregistered neon font-display text-[12vw] leading-[1.1] uppercase [--tube:var(--color-signal)] lg:text-[7rem]"
    >
      Mint
    </p>

    <div
      class="mt-8 flex flex-col gap-8 border-t-2 border-phosphor/20 pt-6 text-sm font-normal tracking-widest uppercase sm:flex-row sm:items-start sm:justify-between"
    >
      <div class="flex flex-col gap-2">
        <p class="text-phosphor-dim">A Hack Club YSWS</p>
        <p class="text-phosphor-dim">&copy; {year}</p>
      </div>

      <ul role="list" class="flex flex-col gap-1 sm:items-end">
        <li>
          <a
            href="https://slack.com/archives/C0BK69GFA0Z"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center py-2 text-mint hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint pointer-coarse:py-3"
          >
            #mint on Slack<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        {
          required.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center py-2 text-phosphor-dim hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint pointer-coarse:py-3"
              >
                {link.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
