---
import Starburst from './Starburst.astro';
import { withBase } from '../lib/url';

// Trimmed of its transparent padding, from the 960x622 master in src/assets.
// At 824px wide it is no longer upscaled at any breakpoint, which the previous
// 422px source was — 1.57x on desktop, worse on high-density screens.
// AVIF and WebP are 60% and 50% lighter than the PNG; the PNG stays as the
// fallback and as the Open Graph image, since scrapers are unreliable on both.
const tin = withBase('altoids-tin-trimmed.png');
const tinWebp = withBase('altoids-tin-trimmed.webp');
const tinAvif = withBase('altoids-tin-trimmed.avif');
---

<div class="relative page-container pt-12 pb-16 sm:pt-16 sm:pb-24">
  <div class="flex items-start justify-between gap-8">
    <p
      class="neon font-script text-5xl [--tube:var(--color-signal)] sm:text-6xl"
    >
      Now!
    </p>

    {/* Marquee plate filling the dead space above the red flag */}
    <div
      class="marquee-bulbs shrink-0 rotate-6 border-x-2 border-amber/45 px-10 py-5 text-center shadow-paste max-sm:hidden"
    >
      <p
        class="neon font-display text-xl leading-[1.25] uppercase [--tube:var(--color-amber)]"
      >
        Beginners
      </p>
      <p
        class="neon font-display text-xl leading-[1.25] uppercase [--tube:var(--color-amber)]"
      >
        welcome
      </p>
    </div>
  </div>

  {/* Brand word lit in red and struck through, as CROSLEY is in the reference */}
  <h1
    class="mt-4 max-w-[20ch] font-display text-4xl leading-[1.15] text-balance uppercase sm:text-5xl lg:text-6xl"
  >
    <span class="rule-through neon [--tube:var(--color-signal)]">Mint</span>
    <span class="text-phosphor text-glow">brings you</span>
    <span class="neon [--tube:var(--color-mint)]">&ldquo;tin-sized&rdquo;</span>
    <span class="text-phosphor text-glow">hardware</span>
  </h1>

  <div class="mt-10 grid items-center gap-10 lg:grid-cols-[6fr_5fr] lg:gap-x-col-lg">
    <div>
      <div class="relative mx-auto w-full max-w-2xl">
        {/* Light pools where the object is, not at an arbitrary offset */}
        <div
          class="bloom pointer-events-none absolute -inset-16 -z-10 [--tube:var(--color-mint)]"
          aria-hidden="true"
        >
        </div>

        <picture>
          <source srcset={tinAvif} type="image/avif" />
          <source srcset={tinWebp} type="image/webp" />
          <img
            src={tin}
            alt="A closed Altoids tin, the build envelope for a Mint project"
            width="824"
            height="602"
            fetchpriority="high"
            decoding="async"
            class="w-full drop-shadow-[3px_8px_16px_color-mix(in_oklab,var(--color-shade)_28%,transparent)]"
          />
        </picture>

        <Starburst
          tone="muted"
          class="absolute -top-3 -left-3 size-24 -rotate-12 sm:size-28"
        >
          <span
            class="block text-[0.625rem] font-bold tracking-widest text-phosphor-dim uppercase"
            >Not a<br />kit</span
          >
        </Starburst>

        <Starburst
          tone="muted"
          class="absolute -right-3 -bottom-3 size-24 rotate-6 sm:size-28"
        >
          <span
            class="block text-[0.625rem] font-bold tracking-widest text-phosphor-dim uppercase"
            >Not a<br />clone</span
          >
        </Starburst>
      </div>

      <p
        class="mt-10 text-center text-xs tracking-widest text-phosphor-dim uppercase"
      >
        Fits within <span class="text-amber text-glow-sm"
          >3.75" &times; 2.375" &times; 0.8"</span
        ><br />the footprint of a real Altoids tin
      </p>
    </div>

    {/* The red plate — escalating price callout, hung slightly crooked */}
    <div class="relative">
      <div
        class="bloom pointer-events-none absolute -inset-14 -z-10 [--tube:var(--color-signal)]"
        aria-hidden="true"
      >
      </div>

      <div
        class="ad-flag -rotate-1 bg-linear-135 from-signal via-signal to-[color-mix(in_oklab,var(--color-signal)_72%,black)] py-7 pr-6 pl-9 shadow-paste-lg sm:pl-11"
    >
      <p
        class="font-display text-sm leading-relaxed text-knockout/80 uppercase line-through decoration-2"
      >
        Not $25&hellip;<br />not $50&hellip;
      </p>
      <p
        class="mt-3 font-display text-2xl leading-[1.2] text-knockout uppercase"
      >
        but a full<br /><span
          class="neon text-[1.6em] [--tube:var(--color-amber-lit)]">$75</span
        > grant
      </p>
      <p
        class="mt-4 border-t-2 border-knockout/40 pt-3 text-xs font-bold tracking-widest text-knockout uppercase"
      >
        Plus the tin itself
      </p>
      </div>
    </div>
  </div>

  <p
    class="neon mt-12 max-w-[26ch] font-script text-3xl text-balance [--tube:var(--color-amber)] sm:max-w-none sm:text-4xl"
  >
    a sensational 2-in-1 value, at pocket size!
  </p>

  <div class="mt-8 grid gap-8 lg:grid-cols-[7fr_5fr] lg:items-end lg:gap-x-panel">
    <p class="max-w-[56ch] text-lg text-pretty text-phosphor-dim sm:text-base">
      Mint is a hardware challenge for small spaces. Ship a project sized to a
      real Altoids tin and we&rsquo;ll send you the tin itself plus a $75 grant
      to fill it.
    </p>

    <div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="#submit"
          class="edge-drawn bg-linear-to-br from-mint to-mint-deep px-6 py-3 text-sm font-bold tracking-widest text-screen uppercase shadow-paste hover:from-mint hover:to-mint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-phosphor"
        >
          Start your project
        </a>
        <a
          href="https://slack.com/archives/C0BK69GFA0Z"
          class="edge-drawn-alt border-2 border-phosphor/35 px-6 py-3 text-sm font-semibold tracking-widest text-phosphor uppercase hover:border-mint hover:text-mint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
        >
          Join #mint on Slack
        </a>
      </div>

      {/* Shown only below lg — at lg and up the header ident carries this. */}
      <p class="mt-5 text-sm text-phosphor-dim lg:hidden">
        For teens <span class="text-amber">13&ndash;18</span>.
      </p>
    </div>
  </div>
</div>
