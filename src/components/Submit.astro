---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';

// Replace with the live Fillout form URL before publishing.
const FORM_URL = 'https://form.fillout.com/t/your-fillout-form-id';
const isPlaceholderForm = FORM_URL.includes('your-fillout-form-id');
---

<Section id="submit" labelledby="submit-title">
  <div class="mx-auto max-w-3xl text-center">
    <Eyebrow class="justify-center">Ready?</Eyebrow>
    <h2
      id="submit-title"
      class="neon mt-6 font-display text-4xl tracking-tight text-balance uppercase [--tube:var(--color-mint)] sm:text-5xl"
    >
      Submit your project
    </h2>
    <p
      class="mx-auto mt-6 max-w-[56ch] text-lg text-pretty text-phosphor-dim sm:text-base"
    >
      Fill out the form below once your project is built and journaled. Have
      questions first? Drop them in <a
        href="https://slack.com/archives/C0BK69GFA0Z"
        class="text-mint underline underline-offset-4 hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
        >#mint</a
      >.
    </p>
  </div>

  <div
    class="edge-drawn mt-12 -rotate-[0.4deg] border-2 border-mint/35 bg-linear-160 from-mint/8 to-transparent p-4 shadow-[0_0_60px_color-mix(in_oklab,var(--color-mint)_18%,transparent)] sm:p-5"
  >
    {
      isPlaceholderForm ? (
        <div class="edge-drawn-alt grid min-h-[26rem] place-items-center border-2 border-dashed border-phosphor/20 p-8 text-center">
          <div>
            <p class="font-display text-2xl tracking-tight text-amber uppercase">
              Form not connected
            </p>
            <p class="mx-auto mt-4 max-w-[56ch] text-base text-pretty text-phosphor-dim sm:text-sm">
              Set <code class="text-mint">FORM_URL</code> in
              <code class="text-mint">src/components/Submit.astro</code> to the
              live Fillout URL and the embed will render here.
            </p>
          </div>
        </div>
      ) : (
        <iframe
          src={FORM_URL}
          title="Mint submission form"
          loading="lazy"
          class="h-[32rem] w-full border-0 bg-screen"
        />
      )
    }
  </div>
</Section>
