---
import Section from './Section.astro';

// Replace with the live Fillout form URL before publishing.
const FORM_URL = 'https://form.fillout.com/t/your-fillout-form-id';
const isPlaceholderForm = FORM_URL.includes('your-fillout-form-id');
---

<Section id="submit" labelledby="submit-title">
  <div class="mx-auto max-w-3xl text-center">
    <h2
      id="submit-title"
      class="neon font-display text-3xl leading-[1.2] text-balance uppercase [--tube:var(--color-mint)] sm:text-4xl lg:text-5xl"
    >
      Submit your design
    </h2>
    <p
      class="justified mx-auto mt-6 max-w-[56ch] text-lg text-pretty text-phosphor-dim sm:text-base"
    >
      Tell us what you want to build and we&rsquo;ll send the tin and the $75 so
      you can build it. Questions first? Drop them in <a
        href="https://slack.com/archives/C0BK69GFA0Z" target="_blank" rel="noopener noreferrer"
        class="text-mint underline underline-offset-4 hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
        >#mint<span class="sr-only"> (opens in a new tab)</span></a
      >.
    </p>
  </div>

  {/* The marquee runs around the one thing on the page you are meant to act
      on. Same bulb device as the hero badge, turned up from an aside to the
      frame of the conversion itself. Vertical padding clears the lamps. */}
  <div
    class="marquee-bulbs mt-14 -rotate-1 border-x-2 border-amber/45 px-4 py-7 shadow-paste-lg sm:px-6 sm:py-9"
  >
    {
      /* While the form is unwired the page must still end on an action, not on
         a diagnostic. The old placeholder printed a source path to visitors and
         reserved 416px of nothing at the page's climax — the worst possible
         final impression under the peak-end rule. The developer note lives in
         the comment above FORM_URL now, not in the DOM. */
      isPlaceholderForm ? (
        <div class="grid place-items-center px-panel py-12 text-center">
          <div>
            <p class="font-display text-base leading-[1.35] text-amber uppercase">
              The form goes live shortly
            </p>
            <p class="mx-auto mt-5 max-w-[48ch] text-base text-pretty text-phosphor-dim">
              Don&rsquo;t wait for it. Post your design in #mint and we&rsquo;ll
              pick it up from there.
            </p>
            <a
              href="https://slack.com/archives/C0BK69GFA0Z" target="_blank" rel="noopener noreferrer"
              class="edge-drawn mt-8 inline-flex min-h-11 items-center bg-linear-to-br from-mint to-mint-deep px-6 py-3 text-sm font-bold tracking-widest text-screen uppercase shadow-paste hover:from-mint hover:to-mint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-phosphor"
            >
              Post your design in #mint<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      ) : (
        <iframe
          src={FORM_URL}
          title="Mint design submission form"
          loading="lazy"
          class="h-[32rem] w-full border-2 border-phosphor/15 bg-screen"
        />
      )
    }
  </div>
</Section>
