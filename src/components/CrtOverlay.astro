---
// The television itself: a fixed cabinet bezel plus the raster/vignette/glare
// stack. Everything here is decorative and must never intercept a pointer or
// reach the accessibility tree.
---

<div class="pointer-events-none fixed inset-0 z-50" aria-hidden="true">
  {/* Vignette + glass glare */}
  <div class="crt-vignette screen-frame rounded-(--radius-screen)"></div>

  {/* Scanlines + aperture grille */}
  <div class="crt-raster screen-frame rounded-(--radius-screen) opacity-70"></div>

  {/* Film grain — kills the flat, rendered look */}
  <div
    class="grain screen-frame rounded-(--radius-screen) opacity-[0.16] mix-blend-overlay"
  >
  </div>

  {/* Cabinet: a huge spread shadow fills everything outside the rounded screen */}
  <div
    class="screen-frame rounded-(--radius-screen) shadow-[0_0_0_100vmax_var(--color-cabinet),inset_0_0_60px_color-mix(in_oklab,var(--color-shade)_75%,transparent)]"
  >
  </div>

  {/* On-screen display, bottom-left, the way a set reports its input */}
  <div
    class="absolute bottom-6 left-6 hidden items-center gap-2 text-[0.6875rem] tracking-widest text-mint uppercase text-glow-sm sm:flex"
  >
    <span class="size-2 rounded-full bg-signal"></span>
    CH 03 · MINT
  </div>
</div>
