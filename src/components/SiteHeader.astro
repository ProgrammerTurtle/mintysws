---
import { withBase } from '../lib/url';

const base = withBase('/');

const links = [
  { href: '#deal', label: 'The deal' },
  { href: '#fits', label: 'What fits' },
  { href: '#how', label: 'How it works' },
];
---

<header
  class="sticky top-0 z-40 border-b-2 border-signal/60 bg-screen/90"
>
  <div
    {/* Wraps rather than overflows: at large text sizes the bar needs more
        width than the viewport has, and wrapping keeps every control reachable
        where shrinking or hiding would not. */}
    class="page-container flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3"
  >
    <div class="flex items-center gap-4">
      <a
        href={base}
        aria-label="Homepage"
        class="flex min-h-11 items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-mint"
      >
        <span
          class="grid size-7 place-items-center bg-signal font-display text-sm leading-none text-knockout"
          aria-hidden="true">M</span
        >
        <span class="font-display text-lg">MINT</span>
      </a>

      {/* Eligibility as a broadcast ident beside the wordmark. Measured: the
          bar needs 405px at 375px wide against 319px available, so it cannot
          share a row with the menu and Submit button on phones. Shown from lg
          up; the hero carries it below that. Exactly one is ever rendered. */}
      <p
        class="border-l-2 border-phosphor/20 pl-4 text-xs whitespace-nowrap text-phosphor-dim max-lg:hidden"
      >
        For teens <span class="text-amber">13&ndash;18</span>.
      </p>
    </div>

    <div class="flex items-center gap-2 sm:gap-6">
      <nav aria-label="Primary" class="max-sm:hidden">
        <ul role="list" class="flex items-center gap-6">
          {
            links.map((link) => (
              <li class="text-xs font-semibold tracking-widest uppercase">
                <a
                  href={link.href}
                  class="inline-flex items-center border-b-2 border-transparent py-2 text-phosphor-dim hover:border-mint hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-mint pointer-coarse:py-3"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Compact JS-free disclosure below the sm breakpoint */}
      <details class="relative sm:hidden">
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center gap-2 border-2 border-phosphor/30 px-3 py-2 text-xs font-semibold tracking-widest text-phosphor-dim uppercase focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
        >
          Menu
        </summary>
        <nav aria-label="Primary" class="absolute right-0 z-10 mt-2 w-48">
          <ul
            role="list"
            class="border-2 border-signal/60 bg-screen-2 p-2 shadow-paste-lg"
          >
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block px-3 py-2.5 text-base font-semibold text-phosphor-dim hover:text-mint focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-mint"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>

      <a
        href="#submit"
        class="inline-flex min-h-11 items-center border-2 border-mint px-3 py-2 text-xs font-semibold tracking-widest text-mint uppercase hover:bg-mint/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
      >
        Submit
      </a>
    </div>
  </div>
</header>
