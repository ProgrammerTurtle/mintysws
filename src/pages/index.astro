---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Deal from '../components/Deal.astro';
import Fits from '../components/Fits.astro';
import Steps from '../components/Steps.astro';
import Why from '../components/Why.astro';
import Submit from '../components/Submit.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Mint — an Altoids-tin hardware YSWS';
const description =
  'Ship a hardware project sized to an Altoids tin, get a $75 grant plus the tin itself, and journal the build.';
---

<Layout title={title} description={description}>
  <SiteHeader />

  {/* Tilted paste-ups and the marquee track overhang the container by design;
      clip on the x-axis so they can never open a horizontal scrollbar. `clip`
      rather than `hidden` so it does not become a scroll container for the
      sticky header. */}
  <main id="main" class="overflow-x-clip">
    {/* Crawl sits above the hero so it is visible without scrolling */}
    <Ticker />
    <Hero />
    <Deal />
    <Fits />
    <Steps />
    <Why />
    <Submit />
  </main>

  <SiteFooter />
</Layout>
