---
// A shareable, single-page advertisement — the whole offer as one printed
// sheet rather than a scrolling page. Deliberately NOT the landing page in a
// different shape: no nav, no crawl, no anchors, nothing that only works in a
// browser. Everything here has to survive being a flat image.
//
// Treated as an aged artifact: a page cut from a 1948 magazine. The photo is a
// real clustered-dot halftone, the red plate is misregistered against the
// black, the stock is yellowed and mottled, and the body copy is a justified
// serif — because mono is the least period-correct thing available and this
// sheet, unlike the site, is not a piece of software.
//
// Sized in A4 proportions so Ctrl/Cmd-P → Save as PDF yields exactly one page
// with no letterboxing. All type is set in `cqw` against the sheet itself, so
// the composition holds at any width instead of reflowing like a web page.
//
// Every claim is drawn from PRODUCT.md. Nothing here is invented copy.
import Starburst from '../components/Starburst.astro';
import { withBase } from '../lib/url';
import { THEME_COLOR } from '../lib/theme';
import '../styles/global.css';

const title = 'Mint — an Altoids-tin hardware YSWS';
const description =
  'Ship a hardware project sized to an Altoids tin, get a $75 grant plus the tin itself, and journal the build.';

// Screened to 8x8 clustered dots at generation time, not filtered in CSS.
const tin = withBase('altoids-tin-halftone.png');

const canonical = new URL(withBase('ad'), Astro.site);

// Printed on the sheet so the ad works as a flat image, detached from any
// hyperlink. Deliberately not derived from `Astro.site`: the flyer advertises
// the public address, which is not the same as the host this build is served
// from.
const AD_URL_LABEL = 'mint.hackclub.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee+Inline&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Yellowtail&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body
    class="grid min-h-dvh place-items-center bg-screen-2 p-4 text-phosphor antialiased sm:p-8"
  >
    <article
      class="ad-sheet @container relative aspect-[210/297] w-full max-w-[52rem] shadow-paste-lg"
      aria-label="Mint advertisement"
    >
      {/* Stock: broad mottle and finer fibre, multiplied into the paper */}
      <div class="paper-mottle pointer-events-none absolute inset-0 opacity-[0.14]" aria-hidden="true"></div>
      <div class="paper-fibre pointer-events-none absolute inset-0 opacity-[0.1]" aria-hidden="true"></div>
      {/* Ink darkens where the page has been handled most — the edges */}
      <div class="page-edges pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative flex h-full flex-col p-[6cqw]">
        {/* Masthead: script kicker left, publisher ident right */}
        <div class="flex items-start justify-between gap-[3cqw]">
          <p class="font-script text-[9cqw] leading-none text-signal misregistered">
            Now!
          </p>
          <p
            class="pt-[1.5cqw] text-right text-[1.6cqw] leading-[1.55] tracking-widest text-phosphor-dim uppercase"
          >
            {/* Break set by hand: this is a two-line block balancing the tall
                script kicker opposite it, not a paragraph left to wrap. */}
            An official<br />Hack Club program
          </p>
        </div>

        <h1
          class="mt-[1cqw] font-display text-[7.4cqw] leading-[1.14] text-balance uppercase"
        >
          <span class="rule-through neon [--tube:var(--color-signal)] misregistered"
            >Mint</span
          > brings you <span class="neon [--tube:var(--color-mint)]"
            >&ldquo;tin-sized&rdquo;</span
          > hardware
        </h1>

        {/* The product, and the offer, side by side — the ad's centre of gravity */}
        <div class="mt-[4cqw] grid grid-cols-[1.35fr_1fr] items-center gap-[4cqw]">
          <div class="relative">
            <img
              src={tin}
              alt="A closed Altoids tin, the build envelope for a Mint project"
              width="824"
              height="602"
              class="w-full"
            />

            <Starburst
              tone="muted"
              class="absolute -top-[2cqw] -left-[2cqw] size-[13cqw] -rotate-12"
            >
              <span
                class="block text-[1.5cqw] leading-[1.35] font-bold tracking-widest text-phosphor-dim uppercase"
                >Not a<br />kit</span
              >
            </Starburst>
          </div>

          {/* The red plate, printed a hair out of register with the black */}
          <div class="relative">
            <div
              class="ad-flag absolute inset-0 -rotate-1 translate-x-[0.4cqw] translate-y-[0.32cqw] bg-[color-mix(in_oklab,var(--color-phosphor)_42%,transparent)]"
              aria-hidden="true"
            >
            </div>
            <div
              class="ad-flag relative -rotate-1 bg-linear-135 from-signal via-signal to-[color-mix(in_oklab,var(--color-signal)_72%,black)] py-[4cqw] pr-[3cqw] pl-[5cqw]"
            >
              <p
                class="font-display text-[2.4cqw] leading-[1.45] text-knockout/90 uppercase line-through decoration-2"
              >
                Not $25&hellip;<br />not $50&hellip;
              </p>
              <p
                class="mt-[1.5cqw] font-display text-[4cqw] leading-[1.16] text-knockout uppercase"
              >
                but a full<br /><span
                  class="neon text-[1.6em] [--tube:var(--color-amber-lit)]">$75</span
                > grant
              </p>
              <p
                class="mt-[2cqw] border-t-2 border-knockout/40 pt-[1.5cqw] text-[1.5cqw] font-bold tracking-widest text-knockout uppercase"
              >
                Plus the tin itself
              </p>
            </div>
          </div>
        </div>

        <p class="mt-[3cqw] font-script text-[4.4cqw] leading-[1.15] text-amber">
          a sensational 2-in-1 value, at pocket size!
        </p>

        {/* Dense two-column sell copy, justified and hyphenated the way a
            period ad was set. */}
        <div
          class="ad-copy mt-[2.5cqw] columns-2 gap-[4cqw] border-t-2 border-phosphor/20 pt-[2.5cqw] text-[1.85cqw] leading-[1.6]"
        >
          <p>
            Build a hardware project that fits inside a real Altoids tin
            &mdash; 3.75&Prime; &times; 2.375&Prime; &times; 0.8&Prime;
            &mdash; and journal the design process on GitHub.
          </p>
          <p class="mt-[1.5cqw]">
            Mint is a hardware challenge for small spaces. Enjoy a refreshing
            break from your long-term projects with an easy and effective
            weekend challenge. Both beginners and advanced users are welcome.
          </p>
        </div>

        {/* The coupon. A print ad's one job is to tell you where to go — and a
            1948 one expected you to cut it out. */}
        <div class="mt-auto flex items-end justify-between gap-[3cqw] pt-[3cqw]">
          <div
            class="coupon relative border-2 border-dashed border-phosphor/45 px-[3cqw] py-[2.5cqw]"
          >
            <span
              class="absolute -top-[1.7cqw] left-[2cqw] bg-[var(--stock)] px-[0.8cqw] text-phosphor-dim"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-[2.6cqw]"
              >
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12"></path>
              </svg>
            </span>

            <p
              class="font-display text-[2.5cqw] leading-[1.25] text-signal uppercase"
            >
              Submit your design
            </p>
            <p class="mt-[1cqw] text-[1.8cqw] leading-[1.5]">
              For teens <span class="text-amber">13&ndash;18</span>, anywhere.
            </p>
            <p
              class="mt-[0.8cqw] text-[1.8cqw] leading-[1.5] tracking-widest text-phosphor-dim uppercase"
            >
              {AD_URL_LABEL} &middot; #mint on Slack
            </p>
          </div>

          <p
            class="misregistered shrink-0 font-display text-[12.5cqw] leading-[0.78] text-signal uppercase"
          >
            Mint
          </p>
        </div>
      </div>
    </article>
  </body>
</html>

<style>
  .ad-sheet {
    /* Yellowed stock, warmer and a touch darker than the site's fresh cream. */
    --stock: oklch(0.915 0.038 84);
    background-color: var(--stock);
    /* Ink spread: a hair of bleed into the fibre, not a blur. */
    text-shadow: 0 0 0.4px currentColor;
  }

  /* Justified and hyphenated, as period body copy was set. */
  .ad-copy {
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  /* Handled edges. Kept shallow on purpose: the reach must stay inside the
     6cqw margin so it never darkens the stock behind body copy. */
  .page-edges {
    box-shadow: inset 0 0 3.2cqw color-mix(in oklab, var(--color-shade) 13%, transparent);
  }

  /* Screen only: the sheet sits very slightly off-square, the way a page
     photographed or scanned out of a magazine does. */
  @media screen {
    .ad-sheet {
      rotate: -0.35deg;
    }
  }

  /* The sheet is the page. No browser chrome, no surround, exact A4 so the
     PDF is one page rather than one-and-a-sliver. print-color-adjust keeps the
     stock, the plate and the paper textures from being optimised away. */
  @media print {
    @page {
      size: A4 portrait;
      margin: 0;
    }

    body {
      display: block;
      min-height: 0;
      padding: 0;
      background: none;
    }

    .ad-sheet {
      width: 210mm;
      height: 297mm;
      max-width: none;
      aspect-ratio: auto;
      rotate: none;
      box-shadow: none;
    }

    :global(html),
    .ad-sheet {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
