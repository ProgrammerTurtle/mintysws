---
// A shareable, single-page advertisement — the whole offer as one printed
// sheet rather than a scrolling page. Deliberately NOT the landing page in a
// different shape: no nav, no crawl, no anchors, nothing that only works in a
// browser. Everything here has to survive being a flat image.
//
// Sized in A4 proportions so Ctrl/Cmd-P → Save as PDF yields exactly one page
// with no letterboxing. All type is set in `cqw` against the sheet itself, so
// the composition holds at any width — on a phone, on a projector, or at
// 210mm — instead of reflowing like a web page.
//
// Every claim is drawn from PRODUCT.md. Nothing here is invented copy.
import Starburst from '../components/Starburst.astro';
import { withBase } from '../lib/url';
import { THEME_COLOR } from '../lib/theme';
import '../styles/global.css';

const title = 'Mint — an Altoids-tin hardware YSWS';
const description =
  'Ship a hardware project sized to an Altoids tin, get a $75 grant plus the tin itself, and journal the build.';

const tin = withBase('altoids-tin-trimmed.png');
const tinWebp = withBase('altoids-tin-trimmed.webp');
const tinAvif = withBase('altoids-tin-trimmed.avif');

const canonical = new URL(withBase('ad'), Astro.site);
// Printed on the sheet so the ad works as a flat image, detached from any
// hyperlink. Deliberately not derived from `Astro.site`: the flyer advertises
// the public address, which is not the same as the host this build is served
// from.
const AD_URL_LABEL = 'mint.hackclub.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee+Inline&family=IBM+Plex+Mono:wght@400;600;700&family=Yellowtail&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body
    class="grid min-h-dvh place-items-center bg-screen-2 p-4 font-sans text-phosphor antialiased sm:p-8"
  >
    <article
      class="ad-sheet @container relative aspect-[210/297] w-full max-w-[52rem] bg-screen shadow-paste-lg"
      aria-label="Mint advertisement"
    >
      <div class="flex h-full flex-col p-[6cqw]">
        {/* Masthead: script kicker left, publisher ident right */}
        <div class="flex items-start justify-between gap-[3cqw]">
          <p class="font-script text-[9cqw] leading-none text-signal">Now!</p>
          <p
            class="max-w-[18ch] pt-[1.5cqw] text-right text-[1.7cqw] leading-[1.5] tracking-widest text-phosphor-dim uppercase"
          >
            A Hack Club YSWS<br />You ship, we ship
          </p>
        </div>

        <h1
          class="mt-[1cqw] font-display text-[7.4cqw] leading-[1.14] text-balance uppercase"
        >
          <span class="rule-through neon [--tube:var(--color-signal)]">Mint</span
          > brings you <span class="neon [--tube:var(--color-mint)]"
            >&ldquo;tin-sized&rdquo;</span
          > hardware
        </h1>

        {/* The product, and the offer, side by side — the ad's centre of gravity */}
        <div class="mt-[4cqw] grid grid-cols-[1.35fr_1fr] items-center gap-[4cqw]">
          <div class="relative">
            <picture>
              <source srcset={tinAvif} type="image/avif" />
              <source srcset={tinWebp} type="image/webp" />
              <img
                src={tin}
                alt="A closed Altoids tin, the build envelope for a Mint project"
                width="824"
                height="602"
                class="w-full drop-shadow-[0.4cqw_1cqw_2cqw_color-mix(in_oklab,var(--color-shade)_28%,transparent)]"
              />
            </picture>

            <Starburst
              tone="muted"
              class="absolute -top-[2cqw] -left-[2cqw] size-[13cqw] -rotate-12"
            >
              <span
                class="block text-[1.5cqw] leading-[1.35] font-bold tracking-widest text-phosphor-dim uppercase"
                >Not a<br />kit</span
              >
            </Starburst>
          </div>

          <div
            class="ad-flag -rotate-1 bg-linear-135 from-signal via-signal to-[color-mix(in_oklab,var(--color-signal)_72%,black)] py-[4cqw] pr-[3cqw] pl-[5cqw] shadow-paste-lg"
          >
            <p
              class="font-display text-[2.4cqw] leading-[1.45] text-knockout/90 uppercase line-through decoration-2"
            >
              Not $25&hellip;<br />not $50&hellip;
            </p>
            <p
              class="mt-[1.5cqw] font-display text-[4cqw] leading-[1.16] text-knockout uppercase"
            >
              but a full<br /><span
                class="neon text-[1.6em] [--tube:var(--color-amber-lit)]">$75</span
              > grant
            </p>
            <p
              class="mt-[2cqw] border-t-2 border-knockout/40 pt-[1.5cqw] text-[1.6cqw] font-bold tracking-widest text-knockout uppercase"
            >
              Plus the tin itself
            </p>
          </div>
        </div>

        <p
          class="mt-[3.5cqw] font-script text-[4.6cqw] leading-[1.15] text-amber"
        >
          a sensational 2-in-1 value, at pocket size!
        </p>

        {/* Dense two-column sell copy, the way the reference sets its body */}
        <div
          class="mt-[3cqw] columns-2 gap-[4cqw] border-t-2 border-phosphor/20 pt-[3cqw] text-[2cqw] leading-[1.55] text-pretty text-phosphor-dim"
        >
          <p>
            Build a hardware project that fits inside a real Altoids tin
            &mdash; 3.75&Prime; &times; 2.375&Prime; &times; 0.8&Prime;
            &mdash; and journal the design process on GitHub.
          </p>
          <p class="mt-[1.5cqw]">
            Mint is a refreshing break from the high-stress long-term projects
            many teens spend all their time on: lower time, lower complexity,
            and flexible enough for beginners and advanced builders alike.
          </p>
        </div>

        {/* The coupon. A print ad's one job is to tell you where to go. */}
        <div
          class="mt-auto flex items-end justify-between gap-[3cqw] border-t-2 border-signal/50 pt-[3cqw]"
        >
          <div>
            <p
              class="font-display text-[2.6cqw] leading-[1.25] text-signal uppercase"
            >
              Submit your design
            </p>
            <p class="mt-[1.2cqw] text-[1.9cqw] leading-[1.5] text-phosphor">
              For teens <span class="text-amber">13&ndash;18</span>, anywhere.
              Ongoing, no deadline.
            </p>
            <p
              class="mt-[1.2cqw] text-[1.9cqw] leading-[1.5] tracking-widest text-phosphor-dim uppercase"
            >
              {AD_URL_LABEL} &middot; #mint on Slack
            </p>
          </div>

          <p
            class="shrink-0 font-display text-[13cqw] leading-[0.78] text-signal uppercase"
          >
            Mint
          </p>
        </div>
      </div>
    </article>
  </body>
</html>

<style>
  /* The sheet is the page. No browser chrome, no surround, exact A4 so the
     PDF is one page rather than one-and-a-sliver. print-color-adjust keeps the
     cream stock and the red plate from being helpfully optimised away. */
  @media print {
    @page {
      size: A4 portrait;
      margin: 0;
    }

    body {
      display: block;
      min-height: 0;
      padding: 0;
      background: none;
    }

    .ad-sheet {
      width: 210mm;
      height: 297mm;
      max-width: none;
      aspect-ratio: auto;
      box-shadow: none;
    }

    :global(html),
    .ad-sheet {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
