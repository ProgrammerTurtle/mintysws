---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Section from '../components/Section.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase } from '../lib/url';

const title = 'Mint — documentation';
const description =
  'Project guidelines, how to submit, and answers to common questions for the Mint hardware YSWS.';

const SLACK_URL = 'https://slack.com/archives/C0BK69GFA0Z';
const home = withBase('/');
// The submission surface lives in the home page's "Submit" section; the header
// Submit button points here too, so docs and header agree on one destination.
const SUBMIT_URL = `${home}#submit`;
// Single source for the build envelope, so the figure is written once and each
// section that needs it references this rather than restating the numbers.
const TIN = '3.75″ × 2.375″ × 0.8″';

// ---------------------------------------------------------------------------
// DRAFT COPY, drawn from PRODUCT.md and the site's existing wording. The prose
// lives in these arrays so it can be rewritten without touching the markup.
// Each section carries distinct information: guidelines are the rules, the
// steps are the sequence, the FAQ is edge cases — repeated facts are trimmed so
// a top-to-bottom reader is not told the same thing three times.
// ---------------------------------------------------------------------------

// Section identity drives both the on-this-page nav and each heading's colour.
const sections = [
  { id: 'guidelines', label: 'Project guidelines', tube: 'var(--color-signal)' },
  { id: 'how-to-submit', label: 'How to submit', tube: 'var(--color-amber)' },
  { id: 'faq', label: 'FAQ', tube: 'var(--color-mint)' },
];

const guidelinesIntro =
  'Mint is a Hack Club YSWS — you ship, we ship. Build a hardware project ' +
  'that fits inside a real Altoids tin, journal the design on GitHub, and we ' +
  'send you the tin plus a $75 grant to build it. Here is what to keep in mind.';

const guidelines = [
  {
    title: 'Fit the tin',
    copy: `Your build has to fit inside a real Altoids tin — ${TIN}. That envelope is the whole brief; everything else is up to you.`,
  },
  {
    title: 'Design first, build after',
    copy: 'Mint funds a design, not a finished build. You submit a design and its journal, the grant and tin follow, and you build once they arrive — so cost is never a barrier to starting.',
  },
  {
    title: 'Journal in the open',
    copy: 'Keep a public JOURNAL.md in your GitHub repository tracking how the design came together. No timelapses, no screen recordings — a written record is enough.',
  },
  {
    title: 'The grant is for parts',
    copy: 'The $75 is paid up front to fund the parts for your build. It arrives before you build, not as a reimbursement after.',
  },
  {
    title: 'Low complexity floor',
    copy: 'All we ask is that you put in some polish and effort. Not quite hasty breadboard projects, but it doesn’t have to be a custom PCB either (though it certainly can be!).',
  },
];

const submitIntro =
  'From idea to funded build in a few steps. The order matters: you design and ' +
  'journal first, then submit, then build once your grant and tin land.';

const submitSteps = [
  {
    title: 'Plan',
    copy: 'Your envelope and budget are fixed — the Altoids tin and the $75 grant. Decide what to build inside those limits.',
  },
  {
    title: 'Design',
    copy: 'Sketch it, prototype it, and work the design out. This is what you submit.',
  },
  {
    title: 'Journal on GitHub',
    copy: 'Create a public GitHub repository and log your design process in a JOURNAL.md file. No timelapses required.',
  },
  {
    title: 'Submit your design',
    copy: 'Send your design and a link to your journal through the Mint submission form.',
  },
  {
    title: 'Get your grant and tin',
    copy: 'We review your design — usually within a week — then send the grant and the tin so you can start building.',
  },
  {
    title: 'Build it',
    copy: 'Build the project inside the tin, and keep your journal public as it comes together.',
  },
];

const faqs = [
  {
    q: 'Who can take part?',
    a: 'Any teen aged 13 to 18, anywhere in the world. You do not need to be a Hack Club member.',
  },
  {
    q: 'What does it cost me?',
    a: 'Nothing. The $75 grant is issued for you to purchase all necessary parts — nothing comes from your pocket.',
  },
  {
    q: 'How big can my project be?',
    a: `It has to fit inside a real Altoids tin: ${TIN}. That is the only hard limit.`,
  },
  {
    q: 'Do I submit a finished build or a design?',
    a: 'A design, plus its journal. Funding follows the design; you build the real thing after the grant and tin arrive.',
  },
  {
    q: 'What do I have to journal?',
    a: 'Keep a public JOURNAL.md in your GitHub repository documenting the design process. No timelapses or screen recordings.',
  },
  {
    q: 'Is there a deadline?',
    a: 'Deadline TBD.',
  },
  {
    q: 'What kinds of things can I build?',
    a: 'Anything that fits the tin — a pocket synth, a tiny game, a mini cyberdeck, whatever you dream up.',
  },
  {
    q: 'I have never built hardware before. Can I still do it?',
    a: 'Yes. Beginners and advanced builders are both encouraged to participate; any skill level is welcome.',
  },
  {
    q: 'How long does review take?',
    a: 'Reviews usually land within a week. Watch the #mint channel on Slack for the latest.',
  },
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main id="main" tabindex="-1" class="overflow-x-clip">
    {/* Masthead + contents. The contents list doubles as in-page navigation. */}
    <div class="page-container pt-12 pb-4 sm:pt-16">
      <p class="text-xs font-semibold tracking-widest text-phosphor-dim uppercase">
        The Mint handbook
      </p>
      <h1
        class="mt-4 max-w-[18ch] font-display text-4xl leading-[1.15] text-balance uppercase sm:text-5xl lg:text-6xl"
      >
        <span class="text-phosphor">Read the</span>
        <span class="neon [--tube:var(--color-mint)]">docs</span>
      </h1>

      {/* Eligibility for mobile: the header only shows the "For teens 13–18"
          ident from lg up, and the docs page has no hero to carry it below
          that — so a phone visitor deep-linking here would not see the age
          range until the FAQ. Mirrors the home hero's lg:hidden line. */}
      <p class="mt-4 text-sm text-phosphor-dim lg:hidden">
        For teens <span class="text-amber">13&ndash;18</span>, anywhere.
      </p>

      <nav aria-label="On this page" class="mt-10">
        <ul
          role="list"
          class="flex flex-wrap gap-x-8 gap-y-3 text-xs font-semibold tracking-widest uppercase"
        >
          {
            sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="inline-flex min-h-11 items-center border-b-2 border-transparent py-2 text-phosphor-dim hover:border-mint hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-mint"
                >
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* -- Project guidelines ------------------------------------------------ */}
    <Section id="guidelines" labelledby="guidelines-title">
      <h2
        id="guidelines-title"
        class="neon max-w-[24ch] font-display text-3xl leading-[1.2] text-balance uppercase [--tube:var(--color-signal)] sm:text-4xl lg:text-5xl"
      >
        Project guidelines
      </h2>
      <p class="justified mt-8 max-w-[60ch] text-lg text-pretty text-phosphor-dim sm:text-base">
        {guidelinesIntro}
      </p>

      <ul role="list" class="mt-12 grid gap-10 sm:grid-cols-2 sm:gap-x-col lg:gap-x-col-lg">
        {
          guidelines.map((item) => (
            <li class="flex gap-3.5">
              <span aria-hidden="true" class="mt-1 shrink-0 text-signal">
                ▸
              </span>
              <div>
                <h3 class="font-display text-base leading-[1.35] text-phosphor uppercase">
                  {item.title}
                </h3>
                <p class="mt-2 max-w-[52ch] text-base text-pretty text-phosphor-dim sm:text-sm">
                  {item.copy}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </Section>

    {/* -- How to submit ----------------------------------------------------- */}
    <Section
      id="how-to-submit"
      labelledby="how-to-submit-title"
      class="border-t-2 border-phosphor/15"
    >
      <h2
        id="how-to-submit-title"
        class="neon max-w-[24ch] font-display text-3xl leading-[1.2] text-balance uppercase [--tube:var(--color-amber)] sm:text-4xl lg:text-5xl"
      >
        How to submit
      </h2>
      <p class="justified mt-8 max-w-[60ch] text-lg text-pretty text-phosphor-dim sm:text-base">
        {submitIntro}
      </p>

      <ol role="list" class="mt-12 space-y-10">
        {
          submitSteps.map((step, index) => {
            // Cycle the palette down the list, as "how it works" does on the
            // home page, so the numerals read as a lit track.
            const tubes = [
              'var(--color-signal)',
              'var(--color-amber)',
              'var(--color-mint)',
            ];
            const tube = tubes[index % tubes.length];
            return (
              <li class="flex gap-5 sm:gap-6">
                <span
                  class="neon shrink-0 font-display text-3xl leading-none tabular-nums sm:text-4xl"
                  style={`--tube: ${tube}`}
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="pt-1">
                  <h3 class="font-display text-base leading-[1.35] text-phosphor uppercase">
                    {step.title}
                  </h3>
                  <p class="mt-2 max-w-[56ch] text-base text-pretty text-phosphor-dim sm:text-sm">
                    {step.copy}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>

      {/* The page's primary action — the submit flow has to resolve somewhere.
          A lead-in ties it to the steps above so the button is the flow's
          conclusion, not a stray control. Points at the home page's Submit
          section, the same destination as the header Submit button, until the
          live form URL exists. */}
      <div class="mt-14 border-t-2 border-phosphor/15 pt-10">
        <p class="max-w-[56ch] text-base text-pretty text-phosphor-dim">
          Design drawn up and journal started? That is everything you need.
        </p>
        <a
          href={SUBMIT_URL}
          class="edge-drawn mt-6 inline-flex min-h-11 items-center bg-linear-to-br from-mint to-mint-deep px-6 py-3 text-sm font-bold tracking-widest text-screen uppercase shadow-paste hover:from-mint hover:to-mint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-phosphor"
        >
          Start your submission
        </a>
      </div>
    </Section>

    {/* -- FAQ --------------------------------------------------------------- */}
    <Section id="faq" labelledby="faq-title" class="border-t-2 border-phosphor/15">
      <h2
        id="faq-title"
        class="neon max-w-[24ch] font-display text-3xl leading-[1.2] text-balance uppercase [--tube:var(--color-mint)] sm:text-4xl lg:text-5xl"
      >
        FAQ
      </h2>

      {/* Native <details> disclosures: each question is a real heading and a
          keyboard/screen-reader control, and answers collapse so the section
          is a short scan on a phone. JS-free. The stable per-question id sits
          on the <details> so a deep link lands on (and opens) the right entry;
          the global :target rule clears the sticky header. */}
      <div class="mt-12 max-w-[68ch] divide-y-2 divide-phosphor/12">
        {
          faqs.map((item) => {
            const id =
              'faq-' +
              item.q
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');
            return (
              <details id={id} class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint [&::-webkit-details-marker]:hidden">
                  <h3 class="font-display text-base leading-[1.35] text-phosphor uppercase group-open:text-mint sm:text-lg">
                    {item.q}
                  </h3>
                  {/* Drawn +/× toggle in the site's typographic idiom, inked in
                      the FAQ's mint plate; rotates to a cross when open. */}
                  <span
                    aria-hidden="true"
                    class="shrink-0 font-display text-xl leading-none text-mint transition-transform duration-200 group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="max-w-[60ch] pb-6 text-base text-pretty text-phosphor-dim">
                  {item.a}
                </p>
              </details>
            );
          })
        }
      </div>

      {/* Repeat the action at the end so a reader who scrolled the whole
          handbook can act without returning to the mid-page button. Secondary
          weight, so it does not compete with the primary CTA above. */}
      <p class="mt-14 flex flex-wrap items-center gap-x-4 gap-y-3 text-base text-phosphor-dim">
        <span>Ready to go?</span>
        <a
          href={SUBMIT_URL}
          class="edge-drawn-alt inline-flex min-h-11 items-center border-2 border-phosphor/35 px-5 py-2.5 text-xs font-semibold tracking-widest text-phosphor uppercase hover:border-mint hover:text-mint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
        >
          Start your submission
        </a>
      </p>

      <p class="mt-12 max-w-[60ch] text-base text-pretty text-phosphor-dim">
        Still have a question? Ask in <a
          href={SLACK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-mint underline underline-offset-4 hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
          >#mint on Slack<span class="sr-only"> (opens in a new tab)</span></a
        >, or head back to the <a
          href={home}
          class="text-mint underline underline-offset-4 hover:text-phosphor focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint"
          >home page</a
        >.
      </p>

      {/* Return to the top of the handbook after the long FAQ — the on-page
          nav lives up there, and a one-thumb reader should not have to flick
          the whole page back. */}
      <p class="mt-10">
        <a
          href="#main"
          class="inline-flex min-h-11 items-center text-xs font-semibold tracking-widest text-phosphor-dim uppercase hover:text-mint focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-mint"
        >
          <span aria-hidden="true" class="mr-2">↑</span>Back to top
        </a>
      </p>
    </Section>
  </main>

  <SiteFooter />
</Layout>
